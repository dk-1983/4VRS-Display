{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "4VRS snapshot v1 (12-card capability)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "key",
    "session",
    "seq",
    "ttl_s",
    "cards"
  ],
  "properties": {
    "schema": {
      "const": 1,
      "type": "integer"
    },
    "key": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "session": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "ttl_s": {
      "type": "integer",
      "minimum": 30,
      "maximum": 300
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "state",
          "unit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 96,
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9_]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "x-maxUtf8Bytes": 96
          },
          "kind": {
            "enum": [
              "fan",
              "light",
              "valve",
              "sensor",
              "binary_sensor",
              "switch",
              "text"
            ]
          },
          "state": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "x-maxUtf8Bytes": 96
          },
          "unit": {
            "type": "string",
            "maxLength": 16,
            "x-maxUtf8Bytes": 16
          }
        }
      }
    }
  }
}
